_TALOSOS_SETUP_CALLER="${(%):-%N}"
_TALOSOS_SETUP_DIR="${${(%):-%N}:A:h}"
. "${_TALOSOS_SETUP_DIR}/setup.sh"
if [ -n "@TALOSOS_COMPLETION_ZSH_REL@" ] && \
   [ -f "${_TALOSOS_SETUP_DIR}/@TALOSOS_COMPLETION_ZSH_REL@" ]; then
  . "${_TALOSOS_SETUP_DIR}/@TALOSOS_COMPLETION_ZSH_REL@"
fi
unset _TALOSOS_SETUP_DIR
unset _TALOSOS_SETUP_CALLER
