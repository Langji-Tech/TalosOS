# CMake / build outputs（只排产物，**不**用 *.cmake 全局匹配，
# 否则会误伤 zenoh-cpp/** 里的 helpers.cmake / FindXxx.cmake 源文件）
/build*/
/install/
/_deps/
build-conda-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
CPackConfig.cmake
CPackSourceConfig.cmake

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Pybind11 扩展如果在源树里编出来的话
python/talosos/_talosos_runtime*.so

# Debian 打包产物
*.deb
*.dsc
*.changes
*.buildinfo
/debian/files

# 文档构建输出
/docs/site/
/docs.tar.bz2

# Rust (zenoh-c 构建)
target/

# IDE / editor
.vscode/
.idea/
.cache/
.claude/
*.swp
*.swo

# OS 杂物
.DS_Store
Thumbs.db

# 临时 / 日志
*.log
/tmp/
*.tmp
/talos_demo_ws/

# 显式排除的样例数据
/image.png
/key_frame_*.pcd
